{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://skillbridge-india-9zpl.onrender.com/api/$1"
    },
    {
      "src": "/health",
      "dest": "https://skillbridge-india-9zpl.onrender.com/health"
    },
    {
      "src": "/docs",
      "dest": "https://skillbridge-india-9zpl.onrender.com/docs"
    },
    {
      "src": "/openapi.json",
      "dest": "https://skillbridge-india-9zpl.onrender.com/openapi.json"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
