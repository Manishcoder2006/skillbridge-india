# ==============================================================================
# SkillBridge India Frontend Environment Configuration
# Public/client-safe variables only (Never expose Secret Key to frontend!)
# ==============================================================================

# For Local Development:
# VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"

# For Vercel Production Deployment:
# Point to your deployed backend Vercel project URL:
VITE_API_BASE_URL="https://your-backend-api.vercel.app/api/v1"

# Supabase Public Configuration (Safe to expose to client)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"
