# ==============================================================================
# SkillBridge India Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="SkillBridge India Portal API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Allowed CORS Origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:5175","http://127.0.0.1:5175","http://localhost:3000","http://127.0.0.1:3000"]

# Backend-only Supabase Configuration (Keep Secret Key strictly server-side!)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# Phase 5: Multi-Model AI Service Configuration (Server-Side Only)
GEMINI_API_KEY="your-google-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
AI_DEFAULT_MODEL="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=15
AI_SIMULATION_FALLBACK=true
